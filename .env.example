# Copy to .env (chmod 600) — scripts/wsl-setup.sh does this for you with a random password.
SIGNALHARBOR_USER=admin
SIGNALHARBOR_PASSWORD=replace-with-a-strong-unique-password
# Keep 127.0.0.1 for local use. WSL2 forwards localhost to Windows, so the Windows browser still works.
SIGNALHARBOR_HOST=127.0.0.1
SIGNALHARBOR_PORT=8088
SIGNALHARBOR_DB=./data/signalharbor.db
# Optional: key used to HMAC-sign audit-chain anchors (GET /api/audit/anchor)
SIGNALHARBOR_AUDIT_KEY=
# Optional: local LLM for the analyst brief (see docs/WSL_DEPLOYMENT.md, step 9)
# SIGNALHARBOR_OLLAMA_URL=http://localhost:11434
# SIGNALHARBOR_OLLAMA_MODEL=llama3
